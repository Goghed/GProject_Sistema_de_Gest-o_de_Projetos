# Copie para .env e ajuste. O .env é carregado automaticamente pelo Django
# (config/settings/base.py) — não é preciso setar variáveis de ambiente
# manualmente a cada sessão de terminal.

# Desenvolvimento local: True. Produção: False (ou omita a linha).
DEBUG=True

# Obrigatório quando DEBUG=False. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=

# Opcional — hosts/domínios permitidos, separados por vírgula (só importa com DEBUG=False)
# ALLOWED_HOSTS=localhost,127.0.0.1,172.10.10.125

# Opcional — origens permitidas por CORS em produção, separadas por vírgula
# CORS_ALLOWED_ORIGINS=https://app.seu-dominio.com
